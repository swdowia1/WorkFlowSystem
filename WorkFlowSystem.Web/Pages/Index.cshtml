@page
@model WorkFlowSystem.Web.Pages.IndexModel

<h2>Users</h2>
<a asp-page="/Users/Create" class="btn btn-primary">
    Użytkownicy
</a>
<a asp-page="/Projects/Index" class="btn btn-primary">
    projekty
</a>
<a asp-page="/Tasks/Index" class="btn btn-warning">
    Zadania
</a>
<table class="table">

    <thead>

        <tr>

            <th>Id</th>

            <th>First Name</th>

            <th>Last Name</th>

            <th>Email</th>

        </tr>

    </thead>

    <tbody>

        @foreach (var user in Model.Users)
        {
            <tr>

                <td>@user.Id</td>

                <td>@user.FirstName</td>

                <td>@user.LastName</td>

                <td>@user.Email</td>

            </tr>
        }

    </tbody>

</table>