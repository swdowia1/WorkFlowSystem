@page
@model WorkFlowSystem.Web.Pages.IndexModel

<h2>Users</h2>
<a asp-page="/Users/Create" class="btn btn-primary">
    Użytkownicy
</a>
<a asp-page="/Projects/Index" class="btn btn-primary">
    projekty
</a>
<a asp-page="/Tasks/Index" class="btn btn-warning">
    Taski
</a>
<div class="dashboard">
    <div class="container">


        <div class="header">

            <div>
                <h1>Open Tasks</h1>
                <p>Active tasks from all projects</p>
            </div>

            <a asp-page="/Tasks/Create"
               class="btn btn-success mb-3">
                Dodaj zadanie
            </a>

        </div>

        <div class="stats">

            <div class="stat-card">
                <span>Projects</span>
                <b>
                    @(Model.Tasks
                                        .Select(x => x.ProjectId)
                                        .Distinct()
                                        .Count())
                </b>
            </div>

            <div class="stat-card">
                <span>Tasks</span>
                <b>
                    @Model.Tasks.Count
                </b>
            </div>

            <div class="stat-card">
                <span>Total Time</span>
                <b>
                    @Model.Tasks.Sum(x => x.TotalHours) h
                </b>
            </div>

        </div>

        <div class="table-card">

            <table>

                <thead>
                    <tr>

                        <th>
                            Task
                        </th>

                        <th>
                            Project
                        </th>

                        <th>
                            Status
                        </th>

                        <th>
                            Priority
                        </th>

                        <th>
                            Due Date
                        </th>

                        <th>
                            Logged
                        </th>

                    </tr>
                </thead>

                <tbody>

                    @foreach (var item in Model.Tasks)
                    {

                        <tr>

                            <td>

                                <div class="task">

                                    <div class="task-number">
                                        @item.TaskId
                                    </div>

                                    <div>

                                        <strong>
                                            @item.TaskTitle
                                        </strong>

                                        <small>
                                            TASK-@item.TaskId
                                        </small>

                                    </div>

                                </div>

                            </td>

                            <td>

                                <span class="project">
                                    @item.ProjectName
                                </span>

                            </td>

                            <td>

                                <span class="badge status">
                                    @item.Status
                                </span>

                            </td>

                            <td>

                                <span class="priority">
                                    @item.Priority
                                </span>

                            </td>

                            <td>

                                @if (item.DueDate.HasValue)
                                {
                                    @item.DueDate.Value.ToString("dd.MM.yyyy")
                                }
                                else
                                {
                                    <span>-</span>
                                }

                            </td>

                            <td>

                                <span class="hours">
                                    ⏱ @item.TotalHours h
                                </span>

                            </td>
                            <td>
                                <button type="button"
                                        class="btn btn-sm btn-outline-primary"
                                        onclick="openWorkLogModal(@item.TaskId)">
                                    Dodaj log
                                </button>
                            </td>

                        </tr>

                    }

                </tbody>

            </table>

        </div>

    </div>
</div>

<!-- Work log modal (reused for all rows) -->
<div class="modal fade" id="workLogModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Dodaj wpis czasu pracy</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="workLogTaskId" value="" />

                <div class="mb-3">
                    <label class="form-label">Czas</label>
                    <div id="indexHoursContainer" class="d-flex flex-wrap gap-2"></div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Opis</label>
                    <textarea id="indexDescription" class="form-control" rows="4" placeholder="Opisz wykonaną pracę..."></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Anuluj</button>
                <button type="button" id="btnSaveWorkLogIndex" class="btn btn-primary" onclick="saveWorkLogIndex()">Dodaj wpis</button>
            </div>
        </div>
    </div>
</div>

<form id="antiForgeryForm" method="post">
    @Html.AntiForgeryToken()
</form>

@section Scripts
{
    <script>
        const indexHours = [
            { text: "15 min", value: 0.25 },
            { text: "30 min", value: 0.5 },
            { text: "1 h", value: 1 },
            { text: "2 h", value: 2 },
            { text: "3 h", value: 3 }
        ];

        let selectedHoursIndex = 0;
        let activeTaskId = 0;

        const containerIndex = document.getElementById("indexHoursContainer");

        indexHours.forEach(item => {
            const button = document.createElement("button");
            button.type = "button";
            button.className = "btn btn-outline-primary";
            button.innerText = item.text;
            button.onclick = function () {
                selectedHoursIndex = item.value;
                document.querySelectorAll("#indexHoursContainer button").forEach(x => {
                    x.classList.remove("btn-primary");
                    x.classList.add("btn-outline-primary");
                });
                button.classList.remove("btn-outline-primary");
                button.classList.add("btn-primary");
            };
            containerIndex.appendChild(button);
        });

        function openWorkLogModal(taskId) {
            activeTaskId = taskId;
            selectedHoursIndex = 0;
            document.getElementById("workLogTaskId").value = taskId;
            document.getElementById("indexDescription").value = "";
            document.querySelectorAll("#indexHoursContainer button").forEach(x => {
                x.classList.remove("btn-primary");
                x.classList.add("btn-outline-primary");
            });

            var modalEl = document.getElementById('workLogModal');
            var modal = new bootstrap.Modal(modalEl);
            modal.show();
        }

        async function saveWorkLogIndex() {
            if (selectedHoursIndex === 0) {
                alert("Wybierz czas.");
                return;
            }

            const description = document.getElementById("indexDescription").value;

            try {
                await api.post("AddWorkLog", {
                    taskId: activeTaskId,
                    hours: selectedHoursIndex,
                    description: description
                });

                location.reload();
            } catch (e) {
                alert("Błąd podczas zapisu: " + (e?.message || e));
            }
        }
    </script>
}

<style>
    .dashboard .container {
        padding: 30px;
        background: #f4f5f7;
        min-height: 100vh;
    }

    .dashboard .header {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

        .dashboard .header p {
            color: #6b778c;
        }

    .dashboard .btn {
        background: #0052cc;
        color: white;
        border: 0;
        padding: 12px 20px;
        border-radius: 8px;
    }

    .dashboard .stats {
        display: flex;
        gap: 20px;
        margin: 25px 0;
    }

    .dashboard .stat-card {
        background: white;
        width: 220px;
        padding: 20px;
        border-radius: 12px;
        box-shadow: 0 2px 8px #ddd;
    }

        .dashboard .stat-card span {
            color: #6b778c;
        }

        .dashboard .stat-card b {
            display: block;
            font-size: 30px;
            margin-top: 10px;
        }

    .dashboard .table-card {
        background: white;
        border-radius: 12px;
        padding: 20px;
    }

    .dashboard table {
        width: 100%;
        border-collapse: collapse;
    }

    .dashboard th {
        text-align: left;
        color: #6b778c;
        padding: 15px;
    }

    .dashboard td {
        padding: 15px;
        border-top: 1px solid #eee;
    }

    .dashboard .task {
        display: flex;
        gap: 12px;
        align-items: center;
    }

    .dashboard .task-number {
        width: 35px;
        height: 35px;
        background: #0052cc;
        color: white;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .dashboard .task small {
        display: block;
        color: #6b778c;
    }

    .dashboard .badge {
        padding: 6px 12px;
        border-radius: 20px;
        background: #deebff;
        color: #0052cc;
    }

    .dashboard .priority {
        font-weight: bold;
    }

    .dashboard .hours {
        font-weight: bold;
        color: #172b4d;
    }
</style>