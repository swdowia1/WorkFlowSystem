@page
@model WorkFlowSystem.Web.Pages.IndexModel

<h2>Users</h2>
<a asp-page="/Users/Create" class="btn btn-primary">
    Użytkownicy
</a>
<a asp-page="/Projects/Index" class="btn btn-primary">
    projekty
</a>
<a asp-page="/Tasks/Index" class="btn btn-warning">
    Taski
</a>
<div class="dashboard">
    <div class="container">


        <div class="header">

            <div>
                <h1>Open Tasks</h1>
                <p>Active tasks from all projects</p>
            </div>


           
                <a asp-page="/Tasks/Create"
                   class="btn btn-success mb-3">
                    Dodaj zadanie
                </a>
           

        </div>



        <div class="stats">


            <div class="stat-card">
                <span>Projects</span>
                <b>
                    @(Model.Tasks
                                        .Select(x => x.ProjectId)
                                        .Distinct()
                                        .Count())
                </b>
            </div>



            <div class="stat-card">
                <span>Tasks</span>
                <b>
                    @Model.Tasks.Count
                </b>
            </div>



            <div class="stat-card">
                <span>Total Time</span>
                <b>
                    @Model.Tasks.Sum(x => x.TotalHours) h
                </b>
            </div>


        </div>



        <div class="table-card">


            <table>


                <thead>
                    <tr>

                        <th>
                            Task
                        </th>

                        <th>
                            Project
                        </th>

                        <th>
                            Status
                        </th>

                        <th>
                            Priority
                        </th>

                        <th>
                            Due Date
                        </th>

                        <th>
                            Logged
                        </th>

                    </tr>
                </thead>



                <tbody>


                    @foreach (var item in Model.Tasks)
                    {

                        <tr>


                            <td>

                                <div class="task">

                                    <div class="task-number">
                                        @item.TaskId
                                    </div>


                                    <div>

                                        <strong>
                                            @item.TaskTitle
                                        </strong>

                                        <small>
                                            TASK-@item.TaskId
                                        </small>

                                    </div>

                                </div>

                            </td>



                            <td>

                                <span class="project">
                                    @item.ProjectName
                                </span>

                            </td>



                            <td>

                                <span class="badge status">
                                    @item.Status
                                </span>

                            </td>



                            <td>

                                <span class="priority">
                                    @item.Priority
                                </span>

                            </td>



                            <td>

                                @if (item.DueDate.HasValue)
                                {
                                    @item.DueDate.Value.ToString("dd.MM.yyyy")
                                }
                                else
                                {
                                    <span>-</span>
                                }

                            </td>



                            <td>

                                <span class="hours">
                                    ⏱ @item.TotalHours h
                                </span>

                            </td>
                            <td>
                                dodaj log
                            </td>

                        </tr>

                    }


                </tbody>


            </table>


        </div>


    </div>
</div>

<style>
    .dashboard .container {
        padding: 30px;
        background: #f4f5f7;
        min-height: 100vh;
    }

    .dashboard .header {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

        .dashboard .header p {
            color: #6b778c;
        }

    .dashboard .btn {
        background: #0052cc;
        color: white;
        border: 0;
        padding: 12px 20px;
        border-radius: 8px;
    }

    .dashboard .stats {
        display: flex;
        gap: 20px;
        margin: 25px 0;
    }

    .dashboard .stat-card {
        background: white;
        width: 220px;
        padding: 20px;
        border-radius: 12px;
        box-shadow: 0 2px 8px #ddd;
    }

        .dashboard .stat-card span {
            color: #6b778c;
        }

        .dashboard .stat-card b {
            display: block;
            font-size: 30px;
            margin-top: 10px;
        }

    .dashboard .table-card {
        background: white;
        border-radius: 12px;
        padding: 20px;
    }

    .dashboard table {
        width: 100%;
        border-collapse: collapse;
    }

    .dashboard th {
        text-align: left;
        color: #6b778c;
        padding: 15px;
    }

    .dashboard td {
        padding: 15px;
        border-top: 1px solid #eee;
    }

    .dashboard .task {
        display: flex;
        gap: 12px;
        align-items: center;
    }

    .dashboard .task-number {
        width: 35px;
        height: 35px;
        background: #0052cc;
        color: white;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .dashboard .task small {
        display: block;
        color: #6b778c;
    }

    .dashboard .badge {
        padding: 6px 12px;
        border-radius: 20px;
        background: #deebff;
        color: #0052cc;
    }

    .dashboard .priority {
        font-weight: bold;
    }

    .dashboard .hours {
        font-weight: bold;
        color: #172b4d;
    }
</style>