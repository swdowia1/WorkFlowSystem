@page "{id:int}"
@model WorkFlowSystem.Web.Pages.Tasks.EditModel

<h2>Edycja zadania</h2>

<form method="post">

    <partial name="_TaskForm"
             model="Model.Form" />

    <button class="btn btn-primary">
        Zapisz zmiany
    </button>

    <a asp-page="Index"
       class="btn btn-secondary">
        Anuluj
    </a>

</form>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}