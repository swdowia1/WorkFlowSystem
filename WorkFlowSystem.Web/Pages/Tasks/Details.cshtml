@page "{id:int}"
@model WorkFlowSystem.Web.Pages.Tasks.DetailsModel

<div class="container-fluid mt-4">

    <div class="row">

        <!-- Lewa część -->
        <div class="col-lg-8">

            <div class="card shadow-sm border-0">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-start">

                        <div>

                            <h2 class="fw-bold mb-1">
                                @Model.Task.Title
                            </h2>

                            <span class="text-muted">
                                @Model.Task.ProjectName
                            </span>

                        </div>

                        @if (Model.Task.IsOverdue)
                        {
                            <span class="badge bg-danger fs-6">
                                Przeterminowane
                            </span>
                        }

                    </div>

                    <hr />

                    <h5>Opis</h5>

                    <div class="task-description">

                        @if (string.IsNullOrWhiteSpace(Model.Task.Description))
                        {
                            <span class="text-muted">
                                Brak opisu
                            </span>
                        }
                        else
                        {
                            @Model.Task.Description
                        }

                    </div>

                    <hr />

                    <h5 class="mb-3">
                        🏷 Tagi
                    </h5>

                    @if (Model.Task.Tags.Any())
                    {
                        <div class="d-flex flex-wrap gap-2">

                            @foreach (var tag in Model.Task.Tags)
                            {
                                <span class="task-tag"
                                      style="background:@tag.Color">

                                    <span>@tag.Name</span>

                                    <button type="button"
                                            class="tag-remove"
                                            onclick="removeTag(@tag.Id)"
                                            title="Usuń tag">

                                        <i class="bi bi-x-circle-fill"></i>
                                        <i class="fa-solid fa-trash"></i>

                                    </button>

                                </span>
                            }

                        </div>
                    }
                    else
                    {
                        <span class="text-muted">
                            Brak przypisanych tagów
                        </span>
                    }
                </div>

            </div>
            <button class="btn btn-primary btn-sm"
                    data-bs-toggle="modal"
                    data-bs-target="#addTagModal">

                + Dodaj tag

            </button>
            <div class="card shadow-sm border-0 mt-4">

                <div class="card-header bg-white">

                    <h5 class="mb-0">
                        WorkLog
                    </h5>

                </div>

                <div class="card-body p-0">

                    <table class="table table-hover mb-0">

                        <thead>

                            <tr>

                                <th>Data</th>

                                <th>Godziny</th>

                                <th>Opis</th>

                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var log in Model.Task.WorkLogs)
                            {
                                <tr>

                                    <td>
                                        @log.WorkDate.ToString("dd.MM.yyyy")
                                    </td>

                                    <td>
                                        <span class="badge bg-primary">
                                            @log.Hours h
                                        </span>
                                    </td>

                                    <td>
                                        @log.Description
                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>

        <!-- Prawa kolumna -->

        <div class="col-lg-4">

            <div class="card shadow-sm border-0">

                <div class="card-header bg-white">

                    <h5 class="mb-0">
                        Szczegóły
                    </h5>

                </div>

                <div class="card-body">

                    <div class="detail-row">

                        <span>Status</span>

                        <strong>@Model.Task.Status</strong>

                    </div>

                    <div class="detail-row">

                        <span>Priorytet</span>

                        <strong>@Model.Task.Priority</strong>

                    </div>

                    <div class="detail-row">

                        <span>Termin</span>

                        <strong>

                            @(Model.Task.DueDate?.ToString("dd.MM.yyyy") ?? "-")

                        </strong>

                    </div>

                    <div class="detail-row">

                        <span>Godziny</span>

                        <strong>

                            @Model.Task.TotalHours h

                        </strong>

                    </div>

                    <div class="detail-row">

                        <span>WorkLog</span>

                        <strong>

                            @Model.Task.WorkLogsCount

                        </strong>

                    </div>
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title">Dodaj wpis czasu pracy</h5>
                           
                        </div>
                        <div class="modal-body">
                            <input type="hidden" id="workLogTaskId" value="" />

                            <div class="mb-3">
                                <label class="form-label">Czas</label>
                                <div id="indexHoursContainer" class="d-flex flex-wrap gap-2"></div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Opis</label>
                                <textarea id="indexDescription" class="form-control" rows="4" placeholder="Opisz wykonaną pracę..."></textarea>
                            </div>
                        </div>
                        
                    </div>

                </div>

            </div>

        </div>

    </div>

</div>
@* Modalne okna *@
<div class="modal fade" id="addTagModal">

    <div class="modal-dialog">

        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Dodaj tag</h5>
            </div>

            <div class="modal-body">

                <div class="d-flex flex-wrap gap-2">

                    @foreach (var tag in Model.Tags)
                    {

                        <span class="task-tag" onclick="addtag(@tag.Id)"
                              style="background:@tag.Color; cursor: pointer;">

                            <span>@tag.Name</span>

                           

                        </span>
                    }

                </div>

            </div>

        </div>

    </div>

</div>
<form id="antiForgeryForm" method="post">

    @Html.AntiForgeryToken()

</form>

<style>
    .task-tag {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 6px 12px;
        border-radius: 999px;
        color: #fff;
    }

    .tag-remove {
        all: unset;
        width: 18px;
        height: 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        cursor: pointer;
        font-size: 16px;
        font-weight: bold;
        line-height: 1;
        color: rgba(255,255,255,.85);
        transition: .2s;
    }

        .tag-remove:hover {
            background: rgba(255,255,255,.25);
            color: #fff;
        }
    

    .detail-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 14px 0;
        border-bottom: 1px solid #ececec;
    }

        .detail-row:last-child {
            border-bottom: none;
        }

    .card {
        border-radius: 14px;
    }

    .table td {
        vertical-align: middle;
    }

    .badge {
        font-size: .9rem;
    }
</style>

<script>
     const indexHours = [
            { text: "15 min", value: 0.25 },
            { text: "30 min", value: 0.5 },
            { text: "1 h", value: 1 },
            { text: "2 h", value: 2 },
            { text: "3 h", value: 3 }
        ];

        let selectedHoursIndex = 0;
        let activeTaskId = 0;

        const containerIndex = document.getElementById("indexHoursContainer");

        indexHours.forEach(item => {
            const button = document.createElement("button");
            button.type = "button";
            button.className = "btn btn-outline-primary";
            button.innerText = item.text;
            button.onclick = function () {
                selectedHoursIndex = item.value;
                document.querySelectorAll("#indexHoursContainer button").forEach(x => {
                    x.classList.remove("btn-primary");
                    x.classList.add("btn-outline-primary");
                });
                button.classList.remove("btn-outline-primary");
                button.classList.add("btn-primary");
                selectHour(item.value)
            };
            containerIndex.appendChild(button);
        });
       async function removeTag(tagId) {
        var taskId = @Model.Task.Id;
        console.log(taskId,tagId);
        if (!confirm("Usunąć tag? "+tagId))
            return;

        await api.post("DeleteTag", {
            taskId: taskId,
            tagId: tagId
        }, true);
    }
        async function selectHour(value) {
            var taskId = @Model.Task.Id;
       const description = document.getElementById("indexDescription").value;

            try {
                await api.post("AddWorkLog", {
                    taskId: taskId,
                    hours: value,
                    description: description
                });

                location.reload();
            } catch (e) {
                alert("Błąd podczas zapisu: " + (e?.message || e));
            }
    }

    async function  addtag(tagId)
    {
      
        
            var taskId = @Model.Task.Id;
           console.log(tagId,taskId);
             await api.post("AddTag", {
        taskId: taskId,
        tagId: tagId
    }, true);
    }
</script>