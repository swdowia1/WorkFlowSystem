@page "{id:int}"
@model WorkFlowSystem.Web.Pages.Tasks.DetailsModel

<div class="container-fluid mt-4">

    <div class="row">

        <!-- Lewa część -->
        <div class="col-lg-8">

            <div class="card shadow-sm border-0">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-start">

                        <div>

                            <h2 class="fw-bold mb-1">
                                @Model.Task.Title
                            </h2>

                            <span class="text-muted">
                                @Model.Task.ProjectName
                            </span>

                        </div>

                        @if (Model.Task.IsOverdue)
                        {
                            <span class="badge bg-danger fs-6">
                                Przeterminowane
                            </span>
                        }

                    </div>

                    <hr />

                    <h5>Opis</h5>

                    <div class="task-description">

                        @if (string.IsNullOrWhiteSpace(Model.Task.Description))
                        {
                            <span class="text-muted">
                                Brak opisu
                            </span>
                        }
                        else
                        {
                            @Model.Task.Description
                        }

                    </div>

                    <hr />

                    <h5 class="mb-3">
                        🏷 Tagi
                    </h5>

                    @if (Model.Task.Tags.Any())
                    {
                        <div class="d-flex flex-wrap gap-2">

                            @foreach (var tag in Model.Task.Tags)
                            {
                                <span class="task-tag"
                                      style="background:@tag.Color">

                                    @tag.Name

                                </span>
                            }

                        </div>
                    }
                    else
                    {
                        <span class="text-muted">
                            Brak przypisanych tagów
                        </span>
                    }
                </div>

            </div>
            <button class="btn btn-primary btn-sm"
                    data-bs-toggle="modal"
                    data-bs-target="#addTagModal">

                + Dodaj tag

            </button>
            <div class="card shadow-sm border-0 mt-4">

                <div class="card-header bg-white">

                    <h5 class="mb-0">
                        WorkLog
                    </h5>

                </div>

                <div class="card-body p-0">

                    <table class="table table-hover mb-0">

                        <thead>

                            <tr>

                                <th>Data</th>

                                <th>Godziny</th>

                                <th>Opis</th>

                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var log in Model.Task.WorkLogs)
                            {
                                <tr>

                                    <td>
                                        @log.WorkDate.ToString("dd.MM.yyyy")
                                    </td>

                                    <td>
                                        <span class="badge bg-primary">
                                            @log.Hours h
                                        </span>
                                    </td>

                                    <td>
                                        @log.Description
                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>

        <!-- Prawa kolumna -->

        <div class="col-lg-4">

            <div class="card shadow-sm border-0">

                <div class="card-header bg-white">

                    <h5 class="mb-0">
                        Szczegóły
                    </h5>

                </div>

                <div class="card-body">

                    <div class="detail-row">

                        <span>Status</span>

                        <strong>@Model.Task.Status</strong>

                    </div>

                    <div class="detail-row">

                        <span>Priorytet</span>

                        <strong>@Model.Task.Priority</strong>

                    </div>

                    <div class="detail-row">

                        <span>Termin</span>

                        <strong>

                            @(Model.Task.DueDate?.ToString("dd.MM.yyyy") ?? "-")

                        </strong>

                    </div>

                    <div class="detail-row">

                        <span>Godziny</span>

                        <strong>

                            @Model.Task.TotalHours h

                        </strong>

                    </div>

                    <div class="detail-row">

                        <span>WorkLog</span>

                        <strong>

                            @Model.Task.WorkLogsCount

                        </strong>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>
@* Modalne okna *@
<div class="modal fade"
     id="addTagModal">

    <div class="modal-dialog">

        <div class="modal-content">

            <div class="modal-header">

                <h5>Dodaj tag</h5>

            </div>

            <div class="modal-body">

                <select id="tagId"
                        class="form-select">

                    @foreach (var tag in Model.Tags)
                    {
                        <option value="@tag.Id">

                            @tag.Name

                        </option>
                    }

                </select>

            </div>

            <div class="modal-footer">

                <button id="saveTag" onclick="addtag()"
                        class="btn btn-primary">

                    Dodaj

                </button>

            </div>

        </div>

    </div>

</div>

<form id="antiForgeryForm" method="post">

    @Html.AntiForgeryToken()

</form>

<style>
    .task-tag {
        color: white;
        padding: 6px 14px;
        border-radius: 30px;
        font-size: .85rem;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        box-shadow: 0 2px 6px rgba(0,0,0,.15);
        transition: .2s;
    }

        .task-tag:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 12px rgba(0,0,0,.25);
        }
    .task-description {
        min-height: 180px;
        background: #fafafa;
        border: 1px solid #e9ecef;
        border-radius: 8px;
        padding: 20px;
        line-height: 1.8;
    }

    .detail-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 14px 0;
        border-bottom: 1px solid #ececec;
    }

        .detail-row:last-child {
            border-bottom: none;
        }

    .card {
        border-radius: 14px;
    }

    .table td {
        vertical-align: middle;
    }

    .badge {
        font-size: .9rem;
    }
</style>

<script>
   
    async function  addtag()
    {
      
         var tagId = $('#tagId').val();
            var taskId = @Model.Task.Id;
           console.log(tagId,taskId);
           await api.post(
        "AddTag",
        {

        taskId:taskId,


        TagId:tagId
       

        });
    }
</script>