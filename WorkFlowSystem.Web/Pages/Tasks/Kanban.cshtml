@page
@using WorkFlowSystem.Domain.Enums
@model WorkFlowSystem.Web.Pages.Tasks.KanbanModel

<div class="container-fluid mt-4">

    <h2 class="mb-4 fw-bold">
        📋 Portfolio Kanban
    </h2>

    @foreach (var project in Model.Tasks)
    {
        <div class="card shadow-sm border-0 mb-5">

            <div class="card-header bg-dark text-white">

                <div class="d-flex justify-content-between align-items-center">

                    <div>

                        <h4 class="mb-1">
                            📁 @project.ProjectName
                        </h4>

                        <small class="text-light">
                            Zarządzanie zadaniami projektu
                        </small>

                    </div>

                    <div>

                        <span class="badge bg-primary me-2">
                            @project.Tasks.Count zadań
                        </span>

                        <span class="badge bg-warning text-dark me-2">
                            @project.Tasks.Count(x => x.Status != TaskProjectStatus.Done)
                            otwartych
                        </span>

                        <span class="badge bg-success">
                            @project.Tasks.Count(x => x.Status == TaskProjectStatus.Done)
                            zakończonych
                        </span>

                    </div>

                </div>

            </div>

            <div class="card-body bg-light">

                <div class="row g-4">

                    <!-- TODO -->

                    <div class="col-lg-4">

                        <div class="kanban-list">

                            <div class="kanban-header bg-primary">

                                TODO
                                <span class="badge bg-light text-dark float-end">

                                    @project.Tasks.Count(x => x.Status == TaskProjectStatus.New)

                                </span>

                            </div>

                            <div class="kanban-column"
                                 data-status="1">

                                @foreach (var task in project.Tasks.Where(x => x.Status == TaskProjectStatus.New))
                                {
                                    <div class="card task-card shadow-sm"
                                         draggable="true"
                                         data-task-id="@task.Id">

                                        <div class="card-body">

                                            <h6 class="fw-bold">

                                                @task.Title

                                            </h6>

                                            <div class="mt-2">

                                                <span class="badge bg-secondary">

                                                    @task.Priority

                                                </span>

                                            </div>

                                        </div>

                                    </div>
                                }

                            </div>

                        </div>

                    </div>

                    <!-- IN PROGRESS -->

                    <div class="col-lg-4">

                        <div class="kanban-list">

                            <div class="kanban-header bg-warning">

                                IN PROGRESS

                                <span class="badge bg-light text-dark float-end">

                                    @project.Tasks.Count(x => x.Status == TaskProjectStatus.InProgress)

                                </span>

                            </div>

                            <div class="kanban-column"
                                 data-status="2">

                                @foreach (var task in project.Tasks.Where(x => x.Status == TaskProjectStatus.InProgress))
                                {
                                    <div class="card task-card shadow-sm"
                                         draggable="true"
                                         data-task-id="@task.Id">

                                        <div class="card-body">

                                            <h6 class="fw-bold">

                                                @task.Title

                                            </h6>

                                            <div class="mt-2">

                                                <span class="badge bg-secondary">

                                                    @task.Priority

                                                </span>

                                            </div>

                                        </div>

                                    </div>
                                }

                            </div>

                        </div>

                    </div>

                    <!-- DONE -->

                    <div class="col-lg-4">

                        <div class="kanban-list">

                            <div class="kanban-header bg-success">

                                DONE

                                <span class="badge bg-light text-dark float-end">

                                    @project.Tasks.Count(x => x.Status == TaskProjectStatus.Done)

                                </span>

                            </div>

                            <div class="kanban-column"
                                 data-status="3">

                                @foreach (var task in project.Tasks.Where(x => x.Status == TaskProjectStatus.Done))
                                {
                                    <div class="card task-card shadow-sm"
                                         draggable="true"
                                         data-task-id="@task.Id">

                                        <div class="card-body">

                                            <h6 class="fw-bold">

                                                @task.Title

                                            </h6>

                                            <div class="mt-2">

                                                <span class="badge bg-secondary">

                                                    @task.Priority

                                                </span>

                                            </div>

                                        </div>

                                    </div>
                                }

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>
    }

</div>
<form id="antiForgeryForm" method="post">
    @Html.AntiForgeryToken()
</form>

<style>

    .task-card{
        cursor:grab;
        transition:.2s;
    }

    .task-card:hover{
        transform:translateY(-2px);
        box-shadow:0 .5rem 1rem rgba(0,0,0,.15);
    }

    .task-card.dragging{
        opacity:.5;
    }

    .kanban-column{
        min-height:600px;
        background:#f8f9fa;
        border-radius:8px;
        transition:.2s;
    }

    .kanban-column.drag-over{
        background:#dbeafe;
    }

</style>

@section Scripts
{
    <script>

        let draggedCard = null;

        document.querySelectorAll(".task-card").forEach(card => {

            card.addEventListener("dragstart", () => {

                draggedCard = card;

                card.classList.add("dragging");

            });

            card.addEventListener("dragend", () => {

                card.classList.remove("dragging");

            });

        });


        document.querySelectorAll(".kanban-column").forEach(column => {

            column.addEventListener("dragover", e => {

                e.preventDefault();

            });

            column.addEventListener("dragenter", () => {

                column.classList.add("drag-over");

            });

            column.addEventListener("dragleave", () => {

                column.classList.remove("drag-over");

            });

            column.addEventListener("drop", async() => {

                column.classList.remove("drag-over");

                if (!draggedCard)
                    return;
                     const previousColumn = draggedCard.parentElement;

                column.appendChild(draggedCard);

                const taskId = draggedCard.dataset.taskId;
                const status = column.dataset.status;

                console.log("Task:", taskId);
                console.log("Nowy status:", status);

                       try {

                   const result = await api.post("UpdateStatus", {
            taskId: taskId,
            status: status
        });

        console.log("RESULT:", result);

            column.appendChild(draggedCard);

        }
        catch(e) {
              console.error("ERROR", e);
            previousColumn.appendChild(draggedCard);

            alert("Nie udało się zmienić statusu.");

        }

            });

        });

    </script>
}