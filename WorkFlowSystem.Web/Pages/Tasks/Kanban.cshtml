@page
@using WorkFlowSystem.Domain.Enums
@model WorkFlowSystem.Web.Pages.Tasks.KanbanModel


<div class="container-fluid mt-4">


    <h2 class="mb-4 fw-bold">
        📋 Portfolio Kanban
    </h2>



    @foreach (var project in Model.Tasks)
    {


        var total = project.Tasks.Count;

        var done = project.Tasks.Count(x =>
        x.Status == TaskProjectStatus.Done);


        var progress = total == 0
        ? 0
        : done * 100 / total;



        <div class="project-card mb-5 shadow">


            <!-- PROJECT HEADER -->

            <div class="project-header">


                <div class="d-flex justify-content-between align-items-center">


                    <div>


                        <h3 class="mb-1">

                            📁 @project.ProjectName

                        </h3>


                        <small>

                            Zarządzanie zadaniami projektu

                        </small>


                    </div>



                    <div class="text-end">


                        <span class="badge bg-light text-dark me-2">

                            @total zadań

                        </span>



                        <span class="badge bg-warning text-dark me-2">

                            @project.Tasks.Count(x => x.Status != TaskProjectStatus.Done)
                            otwartych

                        </span>



                        <span class="badge bg-success">

                            @done zakończonych

                        </span>


                    </div>


                </div>



                <!-- PROGRESS -->

                <div class="mt-3">


                    <div class="d-flex justify-content-between">

                        <small>
                            Postęp projektu
                        </small>

                        <small>
                            @progress %
                        </small>


                    </div>


                    <div class="progress mt-1">


                        <div class="progress-bar"
                             style="width:@progress%">
                        </div>


                    </div>


                </div>


            </div>




            <!-- BODY -->


            <div class="project-body">


                <div class="row g-4">



                    <!-- TODO -->

                    <div class="col-xl-4">


                        <div class="kanban-list">


                            <div class="kanban-header todo">


                                🔵 TODO


                                <span class="badge bg-white text-dark float-end">


                                    @project.Tasks.Count(x =>
                                    x.Status == TaskProjectStatus.New)


                            </span>


                        </div>




                        <div class="kanban-column"
                             data-status="1">


                            @foreach (var task in project.Tasks
                                                        .Where(x => x.Status == TaskProjectStatus.New))
                                {


                                    <partial name="_TaskCard"
                                             model="task" />


                                }


                            </div>


                        </div>


                    </div>






                    <!-- IN PROGRESS -->


                    <div class="col-xl-4">


                        <div class="kanban-list">


                            <div class="kanban-header progress-header">


                                🟠 IN PROGRESS


                                <span class="badge bg-white text-dark float-end">


                                    @project.Tasks.Count(x =>
                                    x.Status == TaskProjectStatus.InProgress)


                            </span>


                        </div>





                        <div class="kanban-column"
                             data-status="2">



                            @foreach (var task in project.Tasks
                                                        .Where(x => x.Status == TaskProjectStatus.InProgress))
                                {


                                    <partial name="_TaskCard"
                                             model="task">


                                    </partial>


                                }



                            </div>


                        </div>


                    </div>






                    <!-- DONE -->



                    <div class="col-xl-4">


                        <div class="kanban-list">


                            <div class="kanban-header done-header">


                                🟢 DONE


                                <span class="badge bg-white text-dark float-end">


                                    @project.Tasks.Count(x =>
                                    x.Status == TaskProjectStatus.Done)


                            </span>


                        </div>




                        <div class="kanban-column"
                             data-status="3">


                            @foreach (var task in project.Tasks
                                                        .Where(x => x.Status == TaskProjectStatus.Done))
                                {


                                    <partial name="_TaskCard"
                                             model="task">


                                    </partial>


                                }



                            </div>


                        </div>


                    </div>



                </div>



            </div>


        </div>


    }



</div>





<form id="antiForgeryForm" method="post">

    @Html.AntiForgeryToken()

</form>






<style>


    body {
        background: #f4f7fb;
    }




    /* PROJECT */


    .project-card {
        border-radius: 22px;
        overflow: hidden;
        border: none;
    }



    .project-header {
        padding: 25px;
        color: white;
        background: linear-gradient( 135deg, #667eea, #764ba2 );
    }



    .project-body {
        padding: 25px;
        background: #eef2ff;
    }




    .progress {
        height: 8px;
        border-radius: 10px;
    }




    .progress-bar {
        background: white;
    }





    /* KANBAN */


    .kanban-list {
        background: white;
        padding: 15px;
        border-radius: 18px;
        box-shadow: 0 8px 25px rgba(0,0,0,.06);
    }




    .kanban-header {
        padding: 14px;
        border-radius: 14px;
        color: white;
        font-weight: 700;
        margin-bottom: 15px;
    }



    .todo {
        background: linear-gradient( 135deg, #3b82f6, #2563eb);
    }




    .progress-header {
        background: linear-gradient( 135deg, #f59e0b, #d97706);
    }




    .done-header {
        background: linear-gradient( 135deg, #10b981, #059669);
    }




    .kanban-column {
        min-height: 550px;
        padding: 10px;
        background: #f8fafc;
        border-radius: 15px;
    }




        .kanban-column.drag-over {
            background: #dbeafe;
        }





    /* TASK */


    .task-card {
        border: none;
        border-radius: 15px;
        margin-bottom: 12px;
        cursor: grab;
        transition: .25s;
    }



        .task-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 12px 25px rgba(0,0,0,.15);
        }



        .task-card::before {
            content: "";
            display: block;
            height: 5px;
            background: #6366f1;
            border-radius: 15px 15px 0 0;
        }



        .task-card.dragging {
            opacity: .5;
        }
</style>





@section Scripts
{

    <script>


        let draggedCard=null;



        document.querySelectorAll(".task-card")
        .forEach(card=>{


        card.addEventListener("dragstart",()=>{


        draggedCard=card;

        card.classList.add("dragging");


        });



        card.addEventListener("dragend",()=>{


        card.classList.remove("dragging");


        });


        });






        document.querySelectorAll(".kanban-column")
        .forEach(column=>{


        column.addEventListener(
        "dragover",
        e=>e.preventDefault()
        );



        column.addEventListener(
        "dragenter",
        ()=>column.classList.add("drag-over")
        );



        column.addEventListener(
        "dragleave",
        ()=>column.classList.remove("drag-over")
        );





        column.addEventListener(
        "drop",
        async()=>{


        column.classList.remove("drag-over");


        if(!draggedCard)
        return;



        const previous =
        draggedCard.parentElement;



        column.appendChild(draggedCard);



        try{


        await api.post(
        "UpdateStatus",
        {

        taskId:
        draggedCard.dataset.taskId,


        status:
        column.dataset.status

        });



        }
        catch(e){


        previous.appendChild(draggedCard);


        alert(
        "Nie udało się zmienić statusu"
        );


        }



        });



        });



    </script>


}