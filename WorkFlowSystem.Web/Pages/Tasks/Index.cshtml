@page
@using WorkFlowSystem.Web.Extensions
@model WorkFlowSystem.Web.Pages.Tasks.IndexModel
<h2>Zadania</h2>

<a asp-page="Create"
   class="btn btn-success mb-3">

    Dodaj zadanie

</a>

<table class="table">

    <tr>
        <th>Projekt</th>
        <th>Tytuł</th>

        <th>Status</th>

        <th>Priorytet</th>
        <th>Akcje</th>
    </tr>

    @foreach (var task in Model.Tasks)
    {
        <tr>
            <td>
            <a asp-page="Details"
               asp-route-id="@task.Id"
               class="btn btn-info btn-sm">
                    @task.Project.Name
                </a>
            </td>
            <td>@task.Title</td>

            <td>@task.Status.GetDescription()</td>

            <td>
                <span class="badge bg-warning text-dark">
                    @task.Priority.GetDescription()
                </span>
            </td>
            <td>

                <a asp-page="Edit"
                   asp-route-id="@task.Id"
                   class="btn btn-warning btn-sm">

                    Edytuj

                </a>

            </td>

        </tr>
    }

</table>
