@page
@using WorkFlowSystem.Web.Extensions
@model WorkFlowSystem.Web.Pages.Tasks.IndexModel
<h2>Zadania</h2>

<a asp-page="Create"
   class="btn btn-success mb-3">

    Dodaj zadanie

</a>

<table class="table">

    <tr>
        <th>Projekt</th>
        <th>Tytuł</th>

        <th>Status</th>

        <th>Priorytet</th>

    </tr>

    @foreach (var task in Model.Tasks)
    {
        <tr>
            <td>@task.Project.Name</td>
            <td>@task.Title</td>

            <td>@task.Status.GetDescription()</td>

            <td>
                <span class="badge bg-warning text-dark">
                    @task.Priority.GetDescription()
                </span>
            </td>

        </tr>
    }

</table>
