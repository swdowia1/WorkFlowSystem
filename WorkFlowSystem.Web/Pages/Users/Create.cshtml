@page
@model WorkFlowSystem.Web.Pages.Users.CreateModel


<h2>Nowy użytkownik</h2>

<form method="post">

    <div class="mb-3">

        <label asp-for="User.FirstName"></label>

        <input asp-for="User.FirstName" class="form-control"/>

        <span asp-validation-for="User.FirstName"
              class="text-danger"></span>

    </div>

    <div class="mb-3">

        <label asp-for="User.LastName"></label>

        <input asp-for="User.LastName"
               class="form-control"/>

        <span asp-validation-for="User.LastName"
              class="text-danger"></span>

    </div>

    <div class="mb-3">

        <label asp-for="User.Email"></label>

        <input asp-for="User.Email"
               class="form-control"/>

        <span asp-validation-for="User.Email"
              class="text-danger"></span>

    </div>

    <button class="btn btn-primary">
        Zapisz
    </button>

</form>

@section Scripts
{
    <partial name="_ValidationScriptsPartial"/>
}
